# 短视频Feed流系统 - 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改配置值
#
# 使用方法：
#   cp .env.example .env
#   编辑 .env 文件，修改为实际配置值
#
# 注意：
#   - .env 文件已在 .gitignore 中排除，不会被提交到仓库
#   - 生产环境请务必修改所有密码和密钥
#   - 本项目的实际配置通过 backend/configs/config.yaml 加载

# ==================== 服务器配置 ====================
# API服务器监听端口
# 取值范围：1024-65535（避免使用系统保留端口）
SERVER_PORT=8080

# ==================== 数据库配置 ====================
# MySQL数据库配置
# 主机地址：本地开发使用localhost，Docker环境使用mysql
DB_HOST=localhost
# 端口号：MySQL默认3306
DB_PORT=3306
# 用户名：建议生产环境使用非root账户
DB_USER=root
# 密码：生产环境请使用强密码（至少8位，包含大小写字母、数字和特殊字符）
DB_PASSWORD=123456
# 数据库名：首次启动时GORM会自动创建表结构
DB_NAME=feedsystem

# ==================== Redis配置 ====================
# Redis缓存配置
# 主机地址：本地开发使用localhost，Docker环境使用redis
REDIS_HOST=localhost
# 端口号：Redis默认6379
REDIS_PORT=6379
# 密码：生产环境请设置强密码
REDIS_PASSWORD=123456
# 数据库索引：0-15，默认使用0
REDIS_DB=0

# ==================== RabbitMQ配置 ====================
# RabbitMQ消息队列配置
# 主机地址：本地开发使用localhost，Docker环境使用rabbitmq
RABBITMQ_HOST=localhost
# AMQP端口：默认5672
RABBITMQ_PORT=5672
# 管理界面用户名
RABBITMQ_USER=admin
# 管理界面密码：生产环境请使用强密码
RABBITMQ_PASSWORD=password123

# RabbitMQ管理界面端口（可选，用于Web管理台访问）
RABBITMQ_MANAGEMENT_PORT=15672

# ==================== 可观测性配置 ====================
# pprof性能分析配置
# 是否启用pprof：生产环境建议关闭
PPROF_ENABLED=true
# API服务的pprof监听地址
PPROF_API_ADDR=localhost:6060
# Worker服务的pprof监听地址
PPROF_WORKER_ADDR=localhost:6061

# ==================== JWT配置 ====================
# JWT签名密钥（生产环境必须修改！）
# 建议使用至少32位的随机字符串
# 生成方法：openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# JWT过期时间（小时）
# 取值范围：1-720（1小时到30天）
JWT_EXPIRATION=24

# ==================== 其他配置 ====================
# 日志级别
# 可选值：debug, info, warn, error
# 生产环境建议使用info或warn
LOG_LEVEL=info

# 是否启用调试模式
# 生产环境必须设置为false
DEBUG_MODE=false
